# 全局日志级别
# 可选: trace/debug/info/warn/error
loglevel = info

[bot]
# Telegram Bot Token (从 @BotFather 获取)
token = YOUR_BOT_TOKEN_HERE

# API基础URL (你的自定义Telegram API，如果有的话)
# 默认使用官方API，如果你有自定义API服务器，可以替换这个URL
# 注意：不需要在URL末尾添加/bot，程序会自动处理
api = https://api.telegram.org

# 管理员用户ID (逗号分隔，用于删除缓存等管理功能)
# 获取方法：发送消息给 @userinfobot 获取你的用户ID
# 示例: botadmin = 123456789,987654321
# 或者使用 bot.admin = 123456789,987654321
botadmin = 

[music]
# 网易云音乐API基础URL (你的自定义NetEase API，如果有的话)
# 默认使用官方API，如果你有自定义API服务器，可以替换这个URL
api = https://music.163.com

# 网易云音乐MUSIC_U Cookie (用于访问付费歌曲和无损音质，可选)
# 获取方法：登录网易云音乐网页版，查看Cookie中的MUSIC_U值
music_u = 

[database]
# 数据库文件路径
url = ./data/music_bot.db

[download]
# 下载目录
dir = ./downloads

# 临时文件存储模式 (v1.1.0+)
# - disk: 传统磁盘文件方式 (推荐默认，稳定，低内存占用)
# - memory: 全程内存处理 (仅建议小文件场景，需足够RAM)
# - hybrid: 智能选择 (小文件用内存，大文件用磁盘)
storage_mode = disk

# 封面模式
# - thumbnail: 默认，仅下载 320x320 缩略图；嵌入封面始终为 320x320 JPEG (Telegram 规范)
# - original: 兼容项，当前与 thumbnail 一致，不再下载原始分辨率
# - both: 兼容项，当前与 thumbnail 一致，不再下载原始分辨率
# 备注: 未来可能扩展高分辨率嵌入，但当前始终为 320x320 JPEG
cover_mode = thumbnail

# 混合模式阈值 (MB)，文件大于此值使用磁盘模式
memory_threshold = 100

# 内存安全缓冲区 (MB)，确保系统有足够可用内存
# 系统可用内存必须 > (文件大小 + 此缓冲区) 才使用内存模式
memory_buffer = 100

# 内存模式文件大小上限 (MB)
# 无论 memory 或 hybrid，文件大于此值都强制使用磁盘模式
# 若需要稳定优先，可设置为更小值（如 16~32）避免大文件走内存上传链路
memory_max_file_mb = 100

# 最大并发下载数 (v1.1.9+)
# 控制同时下载的歌曲数量，较低的值减少内存峰值
# 推荐值: 3-5 (默认值: 3)
max_concurrent = 3

# 单次歌单/专辑下载的最大曲目数（默认 20）
# 当歌单/专辑曲目数超过该值时，将拒绝整单下载
max_batch_tracks = 20

[upload]
# 上传客户端复用请求次数 (v1.1.14+)
# 推荐值: 0
# 设置为 0 表示不按请求次数刷新（仅初始化后持续复用）
client_reuse_requests = 0

# 最大并发上传数 (v1.1.16+)
# 推荐值: 1
max_concurrent = 1

# 本地文件 URI 上传 (需 telegram-bot-api --local，默认 false)
local_file_uri = false

# 上传连接池每主机最大空闲连接数 (v1.1.14+)
# 推荐值: 1
pool_max_idle_per_host = 1

# 上传连接池空闲超时秒数 (v1.1.14+)
# 推荐值: 300
pool_idle_timeout_secs = 300

# 上传诊断日志级别 (v1.1.15+)
# 可选: NONE/ERROR/WARNING/INFO/DEBUG (不区分大小写, WARN=WARNING)
# 注意: 仍受全局 loglevel 影响 (loglevel=info 时 DEBUG 不会显示)
log_level = INFO

# 上传超时时间 (秒)
timeout_secs = 300
