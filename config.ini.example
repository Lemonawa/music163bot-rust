# Global log level
# Options: trace/debug/info/warn/error
# Priority: --log-level > RUST_LOG > config.loglevel > default (info)
# Upload pipeline logs are also controlled here
loglevel = info

[bot]
# Telegram Bot Token (obtain from @BotFather)
token = YOUR_BOT_TOKEN_HERE

# API base URL (custom Telegram Bot API server, if any)
# Defaults to the official API; replace if you run a local bot-api server
# Note: do not append /bot to the URL — the program handles that automatically
api = https://api.telegram.org

# Admin user IDs (comma-separated; grants access to cache deletion and other admin commands)
# To find your user ID, send a message to @userinfobot
# Non-positive IDs are ignored. Either key works: `botadmin` or `admin`.
# Example: admin = 123456789,987654321
admin =

[music]
# NetEase Cloud Music API base URL (custom API server, if any)
# Defaults to the official API; replace if you run a custom API server
api = https://music.163.com

# NetEase Cloud Music MUSIC_U cookie (optional; enables paid tracks and lossless quality)
# To obtain: log in to the NetEase Cloud Music web client and copy the MUSIC_U value from cookies
music_u =

[database]
# Database file path
url = cache.db

[download]
# Download cache directory
dir = ./cache

# Temporary file storage mode (v1.1.0+)
# - disk: traditional disk files (recommended default; stable, low memory usage)
# - memory: in-memory processing (only for small files; requires sufficient RAM)
# - hybrid: automatic selection (small files in memory, large files on disk)
storage_mode = disk

# Cover art mode
# - thumbnail: default; downloads 320x320 thumbnail only; embedded cover is always 320x320 JPEG (Telegram spec)
# - original: downloads and embeds the original high-resolution cover
# - both: embeds high-res cover and generates a 320x320 thumbnail for Telegram preview
cover_mode = thumbnail

# Hybrid mode threshold (MB); files larger than this use disk mode
memory_threshold = 100

# Memory safety buffer (MB); ensures enough free system memory
# System available memory must exceed (file size + this buffer) to use memory mode
memory_buffer = 100

# Maximum file size for memory mode (MB)
# Regardless of memory or hybrid mode, files larger than this always use disk mode
# For stability, consider a smaller value (e.g. 16–32) to avoid large files going through the in-memory upload pipeline
memory_max_file_mb = 100

# Hard cap for total bytes streamed to disk per download (MB; default: 2000)
# Prevents runaway downloads when content_length is unknown or misreported
max_disk_download_mb = 2000

# Maximum concurrent downloads (v1.1.9+)
# Controls how many songs download simultaneously; lower values reduce peak memory usage
# Recommended: 3–5 (default: 3)
max_concurrent = 3

# Maximum tracks per playlist/album download (default: 20)
# Requests exceeding this limit are rejected
max_batch_tracks = 20

# Download connection pool max idle connections per host (default: 2)
pool_max_idle_per_host = 2

# Download connect timeout in seconds (default: 10)
connect_timeout_secs = 10

# Download chunk size in KB (default: 256)
chunk_size_kb = 256

[upload]
# Upload client reuse request count (v1.1.14+)
# Recommended: 0
# Set to 0 to never refresh by request count (reuse the client indefinitely after init)
client_reuse_requests = 0

# Maximum concurrent uploads (v1.1.16+)
# Recommended: 1
max_concurrent = 1

# Local file URI upload (requires telegram-bot-api --local; default: false)
local_file_uri = false

# Upload connection pool max idle connections per host (v1.1.14+)
# Recommended: 1
pool_max_idle_per_host = 1

# Upload connection pool idle timeout in seconds (v1.1.14+)
# Recommended: 300
pool_idle_timeout_secs = 300

# Upload timeout (seconds)
timeout_secs = 300

[maintenance]
# Run memory release every N handled requests (default: 10)
memory_release_interval_requests = 10

# Run SQLite ANALYZE every N handled requests (default: 20)
db_analyze_interval_requests = 20
